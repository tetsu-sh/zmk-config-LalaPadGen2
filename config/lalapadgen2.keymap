#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        mt_hp: mod_hold_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        mt_ba: mod_hold_balanced {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        lt_hp: layer_tap_hold_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&mo>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };

        ime_toggle: ime_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        COMBO_BACKSPACE {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        COMBO_ENTER {
            bindings = <&kp ENTER>;
            key-positions = <18 19>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q              &kp W      &kp E         &kp R      &kp T                                            &kp Y      &kp U     &kp I           &kp O           &mt_ba BACKSPACE P
&kp A    &mt_ba LEFT_SHIFT S  &mt_ba LWIN D  &mt_ba LCTRL F  &kp G                              &kp H      &kp J     &kp K           &kp L           &mt2 ENTER SEMI
&mt_ba LEFT_SHIFT Z  &kp X      &kp C         &kp V      &kp B                                            &mt_ba LWIN N      &kp M     &kp COMMA       &kp PERIOD      &mt_hp RIGHT_SHIFT SLASH
&kp LCTRL          &kp LEFT_ALT   &kp LEFT_WIN  &mt2 LEFT_SHIFT SPACE &mo 2  &kp LEFT_ALT      &mt_hp LWIN ENTER &mt2 LCTRL BACKSPACE  &mo 1     &kp LEFT_ALT     &ime_toggle     &ime_toggle
                   &none      &kp RIGHT     &kp DOWN   &kp LEFT   &kp UP          &kp UP                &kp LEFT   &kp DOWN  &kp RIGHT       &kp C_MUTE
&mkp LCLK          &mkp RCLK  &mkp MCLK                                                                                       &mkp LCLK       &mkp RCLK       &mkp MCLK
&mkp MB4           &mkp MB5   &kp LG(TAB)   &kp LG(D)  &kp LCTRL                                        &mkp MB4   &mkp MB5  &kp LG(TAB)     &kp LG(D)       &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp ESC      &kp F2       &kp F3  &kp F4  &kp F5                                            &kp F6     &kp SQT  &kp BACKSLASH  &kp TILDE &kp DELETE
&kp TAB      &kp N7       &kp N8  &kp N9  &kp N0                                            &kp LEFT          &kp DOWN           &kp UP           &kp RIGHT        &mt2 EQUAL MINUS
&kp F6       &kp F7       &kp F8  &kp F9  &kp F10                                           &mt2 LEFT_BRACKET LEFT_BRACE   &mt2 RIGHT_BRACKET RIGHT_BRACE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_SHIFT
&kp LCTRL    &kp LEFT_ALT &kp LEFT_WIN  &trans  &kp LEFT_SHIFT &kp LEFT_ALT              &mt_hp LWIN DELETE  &mt_hp LCTRL ENTER     &trans     &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_DIVIDE
                  &trans             &trans        &trans        &trans   &trans  &bt BT_SEL 0   &bt BT_SEL 1     &bt BT_SEL 2    &bt BT_SEL 3           &bt BT_CLR
&trans            &trans             &trans                                                                                     &trans           &trans           &trans
&kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans        &trans        &trans                    &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans           &trans           &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&kp F1  &kp F2    &kp F3      &kp F4            &kp F5                                     &kp F6    &kp F7  &kp F8    &kp F9  &kp F12
&kp NUMBER_1     &kp NUMBER_2   &kp NUMBER_3  &kp NUMBER_4       &kp NUMBER_5              &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR         &kp PERCENT               &kp CARET    &kp AMPERSAND  &kp ASTERISK    &kp LEFT_PARENTHESIS  &mt2 RIGHT_SHIFT RIGHT_PARENTHESIS
&kp LCTRL        &kp LEFT_ALT   &kp LEFT_WIN  &mt2 LEFT_SHIFT SPACE &trans  &kp LEFT_ALT   &mt_hp LWIN DELETE  &mt_hp LCTRL ENTER        &trans    &trans          &trans     &trans
                 &trans         &trans        &trans                &trans                 &trans  &trans  &trans         &trans    &trans          &trans
&trans           &trans         &trans                                                                                              &trans          &trans     &trans
&trans           &trans         &trans        &trans                &trans                                 &trans         &trans    &trans          &trans     &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &trans
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &kp C_VOL_DN                   &kp C_VOL_UP                   &kp C_MUTE
         &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                   &trans                         &trans                         &trans
&trans   &trans   &trans   &trans   &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
